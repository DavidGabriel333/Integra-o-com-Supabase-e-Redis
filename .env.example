# Copie este arquivo para ".env" e preencha com os seus dados.
# O arquivo ".env" NAO deve ser enviado ao GitHub (ja esta no .gitignore).

# --- Supabase (Project Settings > API Keys) ---
SUPABASE_URL=COLE_AQUI_A_URL_DO_PROJETO_SUPABASE
SUPABASE_KEY=COLE_AQUI_A_CHAVE_PUBLISHABLE_OU_ANON

# --- Redis Cloud (pagina do banco > Connect) ---
REDIS_HOST=COLE_AQUI_O_HOST_DO_REDIS
REDIS_PORT=COLE_AQUI_A_PORTA_DO_REDIS
REDIS_USER=default
REDIS_PASSWORD=COLE_AQUI_A_SENHA_DO_REDIS
# Bancos gratuitos do Redis Cloud costumam vir sem TLS (false). Use true se o seu exigir.
REDIS_SSL=false

# --- Opcional: tempos de expiracao no Redis (em segundos) ---
TEMPO_CACHE=60
TEMPO_CARRINHO=1800
